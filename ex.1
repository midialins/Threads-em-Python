from threading import Thread
from time import sleep


def mostrar_id(id):
    sleep(0.5)
    print(f"Thread #{id}")


def main():
    threads = []

    # Cria as cinco threads
    for id in range(1, 6):
        thread = Thread(target=mostrar_id, args=(id,))
        threads.append(thread)

    # Inicia todas as threads
    for thread in threads:
        thread.start()

    # Aguarda todas terminarem
    for thread in threads:
        thread.join()


if __name__ == "__main__":
    main()
